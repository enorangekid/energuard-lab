{
  "manifest_version": 3,
  "name": "Energuard Lab Shopping Rank Collector",
  "version": "0.6.3",
  "description": "직원 브라우저에서 네이버 쇼핑 검색결과 전체를 수집하고 자사·추적 상품을 분류합니다.",
  "permissions": ["tabs", "storage"],
  "host_permissions": [
    "https://search.shopping.naver.com/*",
    "https://eukwfypbfqojbaihfqye.supabase.co/*"
  ],
  "action": {
    "default_title": "쇼핑 순위 수집",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "service-worker.js"
  },
  "content_scripts": [
    {
      "matches": ["https://search.shopping.naver.com/search/*"],
      "js": ["parser-core.js", "page-collector.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "http://127.0.0.1/*",
        "http://localhost/*",
        "https://enorangekid.github.io/energuard-lab/*"
      ],
      "js": ["app-bridge.js"],
      "run_at": "document_idle"
    }
  ]
}

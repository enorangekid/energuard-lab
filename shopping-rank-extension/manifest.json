{
  "manifest_version": 3,
  "name": "Energuard Lab Shopping Rank Collector",
  "version": "0.4.2",
  "description": "직원 브라우저에서 네이버 쇼핑 일반 검색 순위를 수집해 에너가드랩에 저장합니다.",
  "permissions": ["tabs", "storage"],
  "host_permissions": [
    "https://search.shopping.naver.com/*",
    "https://eukwfypbfqojbaihfqye.supabase.co/*"
  ],
  "action": {
    "default_title": "쇼핑 순위 수집",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://search.shopping.naver.com/search/*"],
      "js": ["parser-core.js", "page-collector.js"],
      "run_at": "document_idle"
    }
  ]
}
